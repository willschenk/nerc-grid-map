---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../lib/nerc/map/nerc-org-map.css";
import { ROLE_FULL_NAMES, ROLE_TIER, ROLE_WEIGHTS } from "../lib/nerc/roles.mjs";
import { roleSetColor } from "../lib/nerc/enrich.mjs";

const roleOrder = Object.keys(ROLE_WEIGHTS);
const tierNames: Record<number, string> = {
  1: "Grid authority",
  2: "Planning & coordination",
  3: "Asset, load & market",
};
const roleRows = roleOrder.map((tag) => ({
  tag,
  name: ROLE_FULL_NAMES[tag],
  weight: ROLE_WEIGHTS[tag],
  tier: ROLE_TIER[tag],
  color: roleSetColor([tag]),
}));
const tiers = [1, 2, 3].map((t) => ({
  tier: t,
  name: tierNames[t],
  roles: roleRows.filter((r) => r.tier === t),
}));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="NERC Grid Map" wide>
  <link slot="head" rel="preload" as="fetch" href={`${base}nerc/orgs-render.json`} crossorigin />
  <link slot="head" rel="preload" as="fetch" href={`${base}nerc/states-10m.json`} crossorigin />
  <link slot="head" rel="preload" as="fetch" href={`${base}nerc/canada-land.json`} crossorigin />
  <div id="nerc-app">
    <div class="nerc-map-shell" data-nerc-map>
      <section class="nerc-stage" aria-label="NERC organization map">
        <svg id="nerc-svg" viewBox="0 0 960 600" role="img" aria-label="Map of NERC-registered organizations across the United States"></svg>
        <div id="nerc-loading" class="nerc-loading">Loading map...</div>
        <div id="nerc-tooltip" class="nerc-tooltip" hidden></div>
        <div id="nerc-tour-status" class="nerc-tour-status" hidden></div>
        <div id="nerc-focus-status" class="nerc-focus-status" hidden>
          <span class="nerc-focus-text">
            <strong id="nerc-focus-title">PJM selected</strong>
            <span class="nerc-focus-sub">Showing related areas</span>
          </span>
          <button id="nerc-focus-clear" type="button" class="nerc-focus-clear" aria-label="Clear focus">Clear focus</button>
        </div>

        <header class="nerc-topbar" aria-label="Map controls and summary">
          <div class="nerc-brand">
            <h1>NERC Grid Map</h1>
          </div>

          <div class="nerc-map-actions" aria-label="Map actions">
            <button id="nerc-metrics-toggle" type="button" class="nerc-action-btn" aria-label="Dataset summary" title="Dataset summary">Data</button>
            <button id="nerc-info-toggle" type="button" class="nerc-action-btn" aria-label="How to read this map" title="How to read this map">Info</button>
            <button id="nerc-play-tour" type="button" class="nerc-action-btn nerc-play-btn" aria-label="Play walkthrough">Take Tour</button>
          </div>
        </header>

        <button id="nerc-tour-fab" type="button" class="nerc-tour-fab" aria-label="Play walkthrough">Tour</button>

        <div class="nerc-zoom-controls" role="group" aria-label="Zoom controls">
          <button id="nerc-zoom-in" type="button" class="nerc-zoom-btn" aria-label="Zoom in to reveal more organizations" title="Zoom in">+</button>
          <button id="nerc-zoom-out" type="button" class="nerc-zoom-btn" aria-label="Zoom out" title="Zoom out">&#8722;</button>
          <button id="nerc-zoom-home" type="button" class="nerc-zoom-btn nerc-zoom-home" aria-label="Reset map view" title="Reset map view">&#8962;</button>
        </div>

        <aside id="nerc-metrics-panel" class="nerc-popover nerc-metrics-panel" hidden>
          <button id="nerc-metrics-close" type="button" class="nerc-panel-close" aria-label="Close metrics">&times;</button>
          <h2>Dataset summary</h2>
          <div class="nerc-metrics-body" id="nerc-metrics-body" aria-label="Map summary"></div>
        </aside>

        <aside id="nerc-panel" class="nerc-panel" hidden>
          <button id="nerc-panel-close" type="button" class="nerc-panel-close" aria-label="Close">&times;</button>
          <button id="nerc-panel-collapse" type="button" class="nerc-panel-collapse" aria-label="Collapse" aria-expanded="true">&#8211;</button>
          <div id="nerc-panel-body"></div>
        </aside>

        <aside id="nerc-info-panel" class="nerc-popover nerc-info-panel" hidden>
          <button id="nerc-info-close" type="button" class="nerc-panel-close" aria-label="Close">&times;</button>
          <h2>How to read it</h2>
          <p class="nerc-info-lead">Each bubble is one organization, near its headquarters.</p>
          <p class="nerc-info-legend"><b>Color</b> role mix <span aria-hidden="true">&middot;</span> <b>Size</b> role tier <span aria-hidden="true">&middot;</span> <b>Dotted</b> no NERC ID</p>
          <div class="nerc-legend-examples" aria-label="How to read a dot">
            <div class="nerc-legend-row">
              <span class="nerc-legend-swatch nerc-legend-size">
                <span class="nerc-legend-dot nerc-legend-dot-lg"></span>
                <span class="nerc-legend-dot nerc-legend-dot-sm"></span>
              </span>
              <span class="nerc-legend-text"><b>Size shows role tier:</b> ISO/RTOs and reliability authorities are largest, grid operators and utilities are medium, single-role market or generation entities are smallest.</span>
            </div>
            <div class="nerc-legend-row">
              <span class="nerc-legend-swatch">
                <span class="nerc-legend-dot" style="--c:hsl(210, 70%, 52%)"></span>
                <span class="nerc-legend-dot" style="--c:hsl(140, 55%, 45%)"></span>
                <span class="nerc-legend-dot" style="--c:hsl(28, 80%, 55%)"></span>
              </span>
              <span class="nerc-legend-text"><b>Color</b> shows the mix of roles — see the abbreviations below.</span>
            </div>
            <div class="nerc-legend-row">
              <span class="nerc-legend-swatch">
                <span class="nerc-legend-dot nerc-legend-dot-dotted"></span>
              </span>
              <span class="nerc-legend-text"><b>Dotted outline</b> = not in the NERC registry (no NERC ID).</span>
            </div>
          </div>
          <details class="nerc-role-guide">
            <summary>Role abbreviations</summary>
            <div class="nerc-role-guide-grid">
              {
                tiers.map((t) => (
                  <section class="nerc-role-group" aria-label={t.name}>
                    <h2>{t.name}</h2>
                    <div class="nerc-role-defs">
                      {t.roles.map((r) => (
                        <span class="nerc-role-def" data-role={r.tag} style={`--c:${r.color}`} title={r.name}>
                          <span class="nerc-dot" />
                          <strong>{r.tag}</strong>
                          <span>{r.name}</span>
                        </span>
                      ))}
                    </div>
                  </section>
                ))
              }
            </div>
          </details>
          <p class="nerc-info-source">Source: NERC Active Compliance Registry Matrix (Functions)</p>
        </aside>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountNercOrgMap } from "../lib/nerc/map/nerc-org-map";

  mountNercOrgMap();

  const pillExplain: Record<string, string> = {
    BA: "Balancing Authority",
    DP: "Distribution Provider",
    FRSG: "Frequency Response Sharing Group",
    GO: "Generator Owner",
    GOP: "Generator Operator",
    LSE: "Load-Serving Entity",
    PC: "Planning Coordinator",
    PSE: "Purchasing-Selling Entity",
    RC: "Reliability Coordinator",
    RP: "Resource Planner",
    RRSG: "Reactive Reserve Sharing Group",
    RSG: "Reserve Sharing Group",
    TO: "Transmission Owner",
    TOP: "Transmission Operator",
    TP: "Transmission Planner",
    TSP: "Transmission Service Provider",
    "ISO / RTO": "Independent System Operator / Regional Transmission Organization",
    "PJM Zone": "PJM Transmission Zone",
    "MISO LBA": "MISO Local Balancing Authority",
    "NYISO TO": "NYISO Transmission Owner",
    "ISO-NE PTO": "ISO New England Participating Transmission Owner",
    "SPP TO": "Southwest Power Pool Transmission Owner",
  };

  const shell = document.querySelector<HTMLElement>("[data-nerc-map]");
  const pillSelector = ".nerc-rolepill, .nerc-panel-tag";
  let pillExplainTimer: number | undefined;

  function pillText(el: Element | null): string {
    return String(el?.textContent ?? "").replace(/\s+/g, " ").trim();
  }

  function findPill(target: EventTarget | null): HTMLElement | null {
    if (!(target instanceof Element)) return null;
    const pill = target.closest(pillSelector);
    return pill instanceof HTMLElement && shell?.contains(pill) ? pill : null;
  }

  function explainFor(pill: HTMLElement): { code: string; name: string } | null {
    const code = pillText(pill);
    const fromTitle = String(pill.getAttribute("title") || "").trim();
    const text = pill.dataset.role ? pillExplain[pill.dataset.role] : pillExplain[code];
    const name = text || fromTitle || (/^\+\d+/.test(code) ? "Additional roles are hidden in this compact view." : "");
    return name ? { code, name } : null;
  }

  function makePart(className: string, text: string): HTMLSpanElement {
    const span = document.createElement("span");
    span.className = className;
    span.textContent = text;
    return span;
  }

  function hidePillExplain() {
    if (pillExplainTimer != null) window.clearTimeout(pillExplainTimer);
    pillExplainTimer = undefined;
    const popover = document.getElementById("nerc-role-popover");
    if (popover) popover.hidden = true;
  }

  function showPillExplain(pill: HTMLElement): void {
    const info = explainFor(pill);
    const popover = document.getElementById("nerc-role-popover");
    if (!info || !popover) return;

    if (!pill.hasAttribute("title")) pill.setAttribute("title", info.name);
    if (!pill.hasAttribute("aria-label")) pill.setAttribute("aria-label", `${info.code}: ${info.name}`);
    pill.style.cursor = "help";

    popover.replaceChildren(makePart("nerc-role-popover-code", info.code), makePart("nerc-role-popover-name", info.name));
    popover.hidden = false;
    popover.style.visibility = "hidden";
    popover.style.left = "0px";
    popover.style.top = "0px";

    const margin = 8;
    const gap = 8;
    const anchor = pill.getBoundingClientRect();
    const rect = popover.getBoundingClientRect();
    const centered = anchor.left + anchor.width / 2;
    const x = Math.min(window.innerWidth - rect.width - margin, Math.max(margin, centered - rect.width / 2));
    let y = anchor.top - rect.height - gap;
    if (y < margin) y = anchor.bottom + gap;
    y = Math.min(window.innerHeight - rect.height - margin, Math.max(margin, y));

    popover.style.left = `${Math.round(x)}px`;
    popover.style.top = `${Math.round(y)}px`;
    popover.style.visibility = "";

    if (pillExplainTimer != null) window.clearTimeout(pillExplainTimer);
    pillExplainTimer = window.setTimeout(hidePillExplain, 4200);
  }

  shell?.addEventListener("pointerover", (ev) => {
    const pointer = ev as PointerEvent;
    const pill = findPill(ev.target);
    if (!pill || !(pointer.pointerType === "mouse" || window.matchMedia("(hover: hover)").matches)) return;
    showPillExplain(pill);
  }, true);

  shell?.addEventListener("pointerout", (ev) => {
    const pointer = ev as PointerEvent;
    const pill = findPill(ev.target);
    if (!pill || (pointer.relatedTarget instanceof Node && pill.contains(pointer.relatedTarget))) return;
    window.setTimeout(hidePillExplain, 120);
  }, true);

  shell?.addEventListener("click", (ev) => {
    const pill = findPill(ev.target);
    if (pill) showPillExplain(pill);
  }, true);
</script>
